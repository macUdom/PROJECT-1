{
  "name": "savorbite-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + Supabase backend for the SavorBite food storefront",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
